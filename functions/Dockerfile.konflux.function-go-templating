# Konflux / Enterprise Contract image for function-go-templating.
# Parent repo path (submodule stays upstream Dockerfile for local/CI).
# Build context: path-context "functions" (COPY paths use go-templating/…).

ARG GO_BUILD_IMAGE=registry.access.redhat.com/ubi9/go-toolset@sha256:5e68f09a652ac6627a83c57655e42e24575efb278b54336039c9308607fc6b21

FROM ${GO_BUILD_IMAGE} AS build

USER root

ARG TARGETARCH=amd64
ENV CGO_ENABLED=0 GOARCH=${TARGETARCH}

WORKDIR /fn

COPY go-templating/go.mod go-templating/go.sum ./
RUN if [ -f /cachi2/cachi2.env ]; then . /cachi2/cachi2.env; fi && go mod download

COPY go-templating/ ./
RUN if [ -f /cachi2/cachi2.env ]; then . /cachi2/cachi2.env; fi && \
	CGO_ENABLED=0 GOOS=linux go build -trimpath -o /function .

# Assemble xpkg package stream: Crossplane reads a single /package.yaml
# containing the function metadata and all CRDs as a multi-document YAML stream.
RUN sed -s '1i---' package/crossplane.yaml package/input/*.yaml > /tmp/package.yaml

FROM registry.access.redhat.com/ubi9-minimal@sha256:7fbeae18dc9476399f565e68255f602a3374ea8614ba3d14843565131a13ff93

ARG VERSION=0.12.0
ARG RELEASE=1

LABEL name="function-go-templating" \
	version="${VERSION}" \
	release="${RELEASE}" \
	vendor="Red Hat, Inc." \
	summary="Crossplane composition function (Go templates)" \
	description="A Crossplane composition function that composes resources using Go templates." \
	io.k8s.description="Crossplane composition function that composes resources using Go templates." \
	io.k8s.display-name="function-go-templating" \
	com.redhat.component="function-go-templating" \
	url="https://github.com/konflux-ci/crossplane-components" \
	distribution-scope="public"

WORKDIR /

COPY --from=build /function /function
COPY --from=build /tmp/package.yaml /package.yaml

EXPOSE 9443

USER 65532:65532

ENV SSL_CERT_FILE=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem

ENTRYPOINT ["/function"]
