ARG GO_BUILD_IMAGE=registry.access.redhat.com/ubi9/go-toolset@sha256:0b471eb04868f3d9d90bf3c668f9c6c7a22cef07474ac9fec067909dfd7dec7c

FROM ${GO_BUILD_IMAGE} AS build

USER root

ARG TARGETARCH=amd64

WORKDIR /workspace

COPY build-helm/go.mod build-helm/go.sum /workspace/build-helm/
WORKDIR /workspace/build-helm
RUN if [ -f /cachi2/cachi2.env ]; then . /cachi2/cachi2.env; fi && \
	go mod download && \
	CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -trimpath -o /usr/local/bin/helm helm.sh/helm/v3/cmd/helm

WORKDIR /workspace
COPY charts/crossplane /workspace/chart

RUN set -eux; \
	helm version; \
	helm lint /workspace/chart; \
	mkdir -p /workspace/dist; \
	helm package /workspace/chart -d /workspace/dist; \
	mv /workspace/dist/crossplane-konflux-ci-*.tgz /workspace/dist/chart.tgz

FROM registry.access.redhat.com/ubi9-minimal@sha256:7c372902c8d211db2d25c8277ba534a73b92742a334874dced829a63b0f21221

ARG VERSION=2.3.0-rc.0
ARG RELEASE=1

LABEL name="crossplane-helm-chart" \
	version="${VERSION}" \
	release="${RELEASE}" \
	vendor="Red Hat, Inc." \
	summary="Helm chart for Crossplane (Konflux CI)" \
	description="Packaged Helm chart for installing Crossplane with Konflux-built image defaults." \
	io.k8s.description="OCI image storing the crossplane-konflux-ci Helm chart tarball." \
	io.k8s.display-name="crossplane-helm-chart" \
	com.redhat.component="crossplane-helm-chart" \
	url="https://github.com/konflux-ci/crossplane-components" \
	distribution-scope="public"

WORKDIR /chart

COPY --from=build /workspace/dist/chart.tgz /chart/crossplane-chart.tgz

USER 65532:65532

ENV SSL_CERT_FILE=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem

# Chart-only artifact image; exit successfully for scanners that run the container.
CMD ["/bin/true"]
