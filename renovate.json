{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>konflux-ci/mintmaker//config/renovate/renovate.json"],
  "git-submodules": {
    "enabled": true,
    "versioning": "semver"
  },
  "gomod": {
    "packageRules": [
      {
        "description": "Disable updates for indirect Go dependencies since they are resolved by go mod tidy based on direct dependency requirements",
        "matchDepTypes": ["indirect"],
        "enabled": false
      }
    ]
  },
  "packageRules": [
    {
      "description": "Disable digest updates for submodules (keep patch/minor/major via tags)",
      "matchManagers": ["git-submodules"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "description": "Auto-merge Go module updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["digest", "patch", "minor"],
      "automerge": true
    },
    {
      "description": "Group container image digest updates and auto-merge",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["digest"],
      "groupName": "container-digest",
      "automerge": true
    },
    {
      "description": "Auto-merge submodule patch updates",
      "matchManagers": ["git-submodules"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ]
}
